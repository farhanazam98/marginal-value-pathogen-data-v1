# Downloaded/regenerable snapshot data (can be 100s of MB per protein.faa) --
# regenerable from source, not for committing.
# No trailing slash: also matches when this path is a symlink (e.g. to scratch disk).
data/snapshots
data/snapshots/**

# Large sequence/archive formats, wherever they end up
*.faa
*.fna
*.zip

# UniRef100 snapshots: multi-GB, rebuildable from the XML archive
# (deliberately NOT a blanket *.fasta -- data/protein.fasta is tracked)
data/uniref100_*.fasta
data/*.xml.gz

# Pipeline scratch/checkpoint dir -- regenerable output of steps 00-06, not source
data/pssm_pipeline/

# Sweep cells (data/sweep/<protein>/<cell>): keep the small JSON metas + STATUS
# (enough to rebuild sweep_results.csv and audit provenance), drop the heavy
# regenerable binaries (msa_raw.sto, *.npy, *.tbl, query.fasta, predictions/
# scatter). This covers every cell -- year cells and threshold cells alike -- so
# no sweep run commits its regenerable binaries. STATUS sits at the run-dir
# level, outside pssm_pipeline, so it stays tracked.
data/sweep/*/*/data/pssm_pipeline/*
!data/sweep/*/*/data/pssm_pipeline/*.json
# run_sweep.sh's per-protein PID lock, transient
data/sweep/*/.run_sweep.pid

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Private cost/planning reference, not for the public paper repo
COMPUTE_COSTS.md
/logs/

# Machine-specific agent notes (paths/state differ per checkout, e.g. Mac vs EC2)
CLAUDE.local.md
