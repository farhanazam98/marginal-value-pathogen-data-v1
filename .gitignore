# Downloaded/regenerable snapshot data (can be 100s of MB per protein.faa) --
# regenerable from source, not for committing.
# No trailing slash: also matches when this path is a symlink (e.g. to scratch disk).
data/snapshots
data/snapshots/**

# Large sequence/archive formats, wherever they end up
*.faa
*.fna
*.zip

# UniRef100 snapshots: multi-GB, rebuildable from the XML archive
# (deliberately NOT a blanket *.fasta -- data/protein.fasta is tracked)
data/uniref100_*.fasta
data/*.xml.gz

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Private cost/planning reference, not for the public paper repo
COMPUTE_COSTS.md
/logs/

# Machine-specific agent notes (paths/state differ per checkout, e.g. Mac vs EC2)
CLAUDE.local.md
